+ */
+export function resolveElectronUserDataPath(
+	env: Record<string, string | undefined>,
+	isPackaged: boolean,
+	homeDir: string,
+): string {
+	const override = env.AO_ELECTRON_USER_DATA_DIR?.trim();
+	if (override) {
+		if (!path.isAbsolute(override)) {
