#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
# shellcheck source=../lib/dcp-ao-common.sh
source "$REPO_ROOT/lib/dcp-ao-common.sh"
# shellcheck source=../lib/dcp-ao-gateway.sh
source "$REPO_ROOT/lib/dcp-ao-gateway.sh"

usage() {
	cat <<'EOF'
Usage: bin/dcp-ao <command>

Commands:
  prepare      fetch, pin, verify, and apply the exact patch queue
  deps         install locked build dependencies in managed source
  build        run model-free tests and build the native arm64 app
  install      build, ad-hoc sign, and install the canonical app bundle
  preflight    verify source, installed artifact, identity, and worker isolation
  init-target  create/adopt the disposable remote-free dcp-lab target
  status       show the packaged daemon status
  doctor       run the packaged daemon/CLI doctor
  paths        print the exact packaged contour

DCP_AO_LAB_ROOT must be exactly ~/Library/Application Support/DCP Orchestrator.
Normal task entry is only bin/dcp-ao-submit. Source/dev is build/test only and
never owns the DCP Lab daemon.
EOF
}

install_deps() {
	local source_dir="$1"
	dcp_ao_use_supported_node
	dcp_ao_require_tool npm
	(cd "$source_dir" && npm ci --prefer-offline --fetch-retries=5 --fetch-retry-mintimeout=1000 --fetch-retry-maxtimeout=10000)
	(cd "$source_dir/frontend" && npm ci --prefer-offline --fetch-retries=5 --fetch-retry-mintimeout=1000 --fetch-retry-maxtimeout=10000)
}

init_target() {
	local lab_root="$1" target="$lab_root/targets/dcp-lab" worktree
	if [[ ! -e "$target" ]]; then
		mkdir -p "$target"
		git -C "$target" init -b main
		git -C "$target" config user.name 'DCP Lab'
		git -C "$target" config user.email 'dcp-lab@example.invalid'
		printf 'DCP AO I3 disposable synthetic target\n' >"$target/.dcp-lab-target"
		git -C "$target" add .dcp-lab-target
		git -C "$target" commit -m 'chore: initialize disposable DCP lab target'
	fi
	[[ -d "$target/.git" ]] || dcp_ao_fail "refusing non-repository target: $target"
	[[ "$(git -C "$target" rev-parse --show-toplevel)" == "$(cd "$target" && pwd -P)" ]] || dcp_ao_fail 'target repository root mismatch'
	[[ -z "$(git -C "$target" remote)" ]] || dcp_ao_fail 'dcp-lab must have no remotes'
	[[ "$(git -C "$target" ls-files)" == .dcp-lab-target ]] || dcp_ao_fail 'dcp-lab baseline tracks unexpected files'
	[[ "$(git -C "$target" branch --show-current)" == main ]] || dcp_ao_fail 'dcp-lab baseline branch must be main'
	[[ "$(git -C "$target" rev-list --count HEAD)" -eq 1 ]] || dcp_ao_fail 'dcp-lab baseline must contain exactly one commit'
	[[ "$(dcp_ao_sha256 "$target/.dcp-lab-target")" == 63af912083e6fc32693b315457555805855fe3db87bc6ab730946a061a2219f1 ]] || dcp_ao_fail 'dcp-lab marker mismatch'
	while IFS= read -r worktree; do
		[[ "$worktree" == "$target" || "$worktree" == "$lab_root/data/worktrees/"* ]] || dcp_ao_fail "foreign linked worktree: $worktree"
	done < <(git -C "$target" worktree list --porcelain | sed -n 's/^worktree //p')
	git -C "$target" diff --quiet && git -C "$target" diff --cached --quiet
	printf '%s\n' "$target"
}

build_app() {
	local lab_root="$1" source_dir output
	source_dir="$(dcp_ao_prepare_source "$lab_root")"
	install_deps "$source_dir"
	dcp_ao_require_tool go
	(cd "$source_dir/backend" && go test -p 1 ./... && go build ./...)
	dcp_ao_use_supported_node
	(
		cd "$source_dir/frontend"
		npm run typecheck
		npx vitest run --config vite.renderer.config.ts \
			src/main/app-state.test.ts \
			src/main/daemon-owner.test.ts \
			src/shared/daemon-launch.test.ts \
			src/renderer/lib/spawn-orchestrator.test.ts \
			src/renderer/__tests__/integration/board-empty-states.test.tsx \
			src/renderer/components/RestoreUnavailableDialog.test.tsx
		AO_TELEMETRY_RENDERER=off AO_TELEMETRY_EVENTS=off AO_TELEMETRY_METRICS=off AO_TELEMETRY_REMOTE=off \
			VITE_AO_POSTHOG_KEY= npm run package -- --arch=arm64
	)
	output="$(dcp_ao_package_output "$lab_root")"
	codesign --force --deep --sign - "$output"
	dcp_ao_verify_bundle_at "$output"
	dcp_ao_verify_source "$lab_root"
	printf '%s\n' "$output"
}

install_app() {
	local lab_root="$1" built app parent staging backup receipt app_pid
	build_app "$lab_root"
	built="$(dcp_ao_package_output "$lab_root")"; app="$(dcp_ao_app_path)"; parent="$(dirname "$app")"
	app_pid="$(dcp_ao_gateway_exact_app_pid 2>/dev/null || true)"
	[[ -z "$app_pid" ]] || { dcp_ao_fail 'quit the exact DCP app before replacing its bundle'; return 1; }
	mkdir -p "$parent" "$lab_root/build/backups" "$(dirname "$(dcp_ao_install_receipt "$lab_root")")"
	staging="$parent/.DCP-Orchestrator-install-$$.app"
	[[ ! -e "$staging" ]] || { dcp_ao_fail 'install staging path already exists'; return 1; }
	ditto "$built" "$staging"
	codesign --force --deep --sign - "$staging"
	dcp_ao_verify_bundle_at "$staging"
	if [[ -e "$app" ]]; then
		dcp_ao_verify_bundle_at "$app" || { dcp_ao_fail 'refusing to replace an app with foreign identity'; return 1; }
		backup="$lab_root/build/backups/DCP Orchestrator-$(date -u +%Y%m%dT%H%M%SZ).app"
		mv "$app" "$backup"
	fi
	mv "$staging" "$app"
	dcp_ao_verify_bundle_at "$app"
	receipt="$(dcp_ao_install_receipt "$lab_root")"
	{
		printf 'schema=1\n'
		printf 'bundle_path=%s\n' "$app"
		printf 'bundle_id=pro.devcontrol.dcp-orchestrator\n'
		printf 'upstream_commit=%s\n' "$DCP_AO_UPSTREAM_COMMIT"
		printf 'patch_sha256=%s\n' "$DCP_AO_PATCH_SHA256"
		printf 'daemon_sha256=%s\n' "$(dcp_ao_sha256 "$(dcp_ao_embedded_cli)")"
		printf 'asar_sha256=%s\n' "$(dcp_ao_sha256 "$app/Contents/Resources/app.asar")"
		printf 'installed_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	} >"$receipt"
	chmod 600 "$receipt"
	dcp_ao_verify_installed_bundle "$lab_root"
	printf 'installed %s\n' "$app"
}

command="${1:-}"; [[ -n "$command" ]] || { usage; exit 2; }; shift || true
[[ "$#" -eq 0 ]] || dcp_ao_fail "unexpected arguments for $command"
if [[ "$command" == -h || "$command" == --help || "$command" == help ]]; then usage; exit 0; fi
lab_root="$(dcp_ao_require_lab_root)"

case "$command" in
	prepare) dcp_ao_prepare_source "$lab_root" >/dev/null; dcp_ao_verify_source "$lab_root"; printf 'prepared %s\n' "$(dcp_ao_source_dir "$lab_root")" ;;
	deps) source_dir="$(dcp_ao_prepare_source "$lab_root")"; install_deps "$source_dir"; dcp_ao_verify_source "$lab_root" ;;
	build) build_app "$lab_root" ;;
	install) install_app "$lab_root" ;;
	preflight) dcp_ao_preflight_exact_contour "$lab_root"; dcp_ao_print_contour "$lab_root" ;;
	init-target) init_target "$lab_root" ;;
	status|doctor)
		dcp_ao_verify_installed_bundle "$lab_root"; dcp_ao_export_runtime_env "$lab_root"; cli="$(dcp_ao_embedded_cli)"
		if [[ "$command" == status ]]; then "$cli" status --json; else "$cli" doctor --json; fi
		;;
	paths) dcp_ao_print_contour "$lab_root" ;;
	*) usage >&2; exit 2 ;;
esac
