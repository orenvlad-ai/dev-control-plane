#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
# shellcheck source=../lib/dcp-ao-common.sh
source "$REPO_ROOT/lib/dcp-ao-common.sh"
# shellcheck source=../lib/dcp-ao-adapter.sh
source "$REPO_ROOT/lib/dcp-ao-adapter.sh"
# shellcheck source=../lib/dcp-ao-gateway.sh
source "$REPO_ROOT/lib/dcp-ao-gateway.sh"
# shellcheck source=../lib/dcp-ao-install.sh
source "$REPO_ROOT/lib/dcp-ao-install.sh"
# shellcheck source=../lib/dcp-ao-stage6-direct-install.sh
source "$REPO_ROOT/lib/dcp-ao-stage6-direct-install.sh"

usage() {
	cat <<'EOF'
Usage: bin/dcp-ao <command>

Commands:
  prepare      fetch and verify the exact managed fork commit
  deps         install locked build dependencies in managed source
  build        run model-free tests and build the native arm64 app
  install      build, ad-hoc sign, and install the canonical app bundle
  install-stage6-recovery install the one reviewed same-identity recovery bundle
  install-stage6-aggregate install the one reviewed aggregate seam-closure bundle
  install-stage6-direct-model install and migrate the one reviewed direct-model bundle once
  install-stage6-final install and migrate the exact reviewed final bundle once
  preflight    verify source, installed artifact, identity, and worker isolation
  preflight-stage5 verify the one-time stopped schema-84/zero-state activation
  preflight-stage6-recovery verify the exact stopped schema-85 recovery fence
  preflight-stage6-aggregate verify the exact stopped aggregate install fence
  preflight-stage6-direct-model verify the exact stopped schema-86 direct-model fence
  preflight-stage6-final verify the exact stopped schema-87 final install fence
  adopt-stage6-final atomically consume the frozen Worker receipt once without model/provider effect
  preflight-stage6-final-adopted verify the exact stopped post-adoption fence
  continue-stage6-final perform the one governed live continuation start
  restart-stage6-final-dedupe perform the one post-terminal restart/dedupe proof
  init-target  create/adopt the disposable remote-free dcp-lab target
  init-wb-core create/adopt the exact read-only wb-core baseline target
  init-twin    clone/adopt the exact integration-twin Stage 5 baseline
  register-wb-core register the locked wb-core native project model-free
  status       show the packaged daemon status
  doctor       run the packaged daemon/CLI doctor
  paths        print the exact packaged contour

DCP_AO_LAB_ROOT must be exactly ~/Library/Application Support/DCP Orchestrator.
Normal task entry is only bin/dcp-ao-submit. Source/dev is build/test only and
never owns the DCP Lab daemon.
EOF
}

install_deps() {
	local source_dir="$1"
	dcp_ao_use_supported_node
	dcp_ao_require_tool npm
	(cd "$source_dir" && npm ci --prefer-offline --fetch-retries=5 --fetch-retry-mintimeout=1000 --fetch-retry-maxtimeout=10000)
	(cd "$source_dir/frontend" && npm ci --prefer-offline --fetch-retries=5 --fetch-retry-mintimeout=1000 --fetch-retry-maxtimeout=10000)
}

init_target() {
	local lab_root="$1" target="$lab_root/targets/dcp-lab" worktree
	if [[ ! -e "$target" ]]; then
		mkdir -p "$target"
		git -C "$target" init -b main
		git -C "$target" config user.name 'DCP Lab'
		git -C "$target" config user.email 'dcp-lab@example.invalid'
		printf 'DCP AO I3 disposable synthetic target\n' >"$target/.dcp-lab-target"
		git -C "$target" add .dcp-lab-target
		git -C "$target" commit -m 'chore: initialize disposable DCP lab target'
	fi
	[[ -d "$target/.git" ]] || dcp_ao_fail "refusing non-repository target: $target"
	[[ "$(git -C "$target" rev-parse --show-toplevel)" == "$(cd "$target" && pwd -P)" ]] || dcp_ao_fail 'target repository root mismatch'
	[[ -z "$(git -C "$target" remote)" ]] || dcp_ao_fail 'dcp-lab must have no remotes'
	[[ "$(git -C "$target" ls-files)" == .dcp-lab-target ]] || dcp_ao_fail 'dcp-lab baseline tracks unexpected files'
	[[ "$(git -C "$target" branch --show-current)" == main ]] || dcp_ao_fail 'dcp-lab baseline branch must be main'
	[[ "$(git -C "$target" rev-list --count HEAD)" -eq 1 ]] || dcp_ao_fail 'dcp-lab baseline must contain exactly one commit'
	[[ "$(dcp_ao_sha256 "$target/.dcp-lab-target")" == 63af912083e6fc32693b315457555805855fe3db87bc6ab730946a061a2219f1 ]] || dcp_ao_fail 'dcp-lab marker mismatch'
	while IFS= read -r worktree; do
		[[ "$worktree" == "$target" || "$worktree" == "$lab_root/data/worktrees/"* ]] || dcp_ao_fail "foreign linked worktree: $worktree"
	done < <(git -C "$target" worktree list --porcelain | sed -n 's/^worktree //p')
	git -C "$target" diff --quiet && git -C "$target" diff --cached --quiet
	printf '%s\n' "$target"
}

build_app() {
	local lab_root="$1" source_dir output
	source_dir="$(dcp_ao_prepare_source "$lab_root")"
	install_deps "$source_dir"
	(cd "$source_dir" && ./scripts/dcp-ci-gates.sh source)
	(cd "$source_dir" && npm run sqlc && npm run api && git diff --exit-code)
	dcp_ao_require_tool go
	(cd "$source_dir/backend" && go test -p 1 ./... && go build ./...)
	dcp_ao_use_supported_node
	(
		cd "$source_dir/frontend"
		npm run typecheck
		npx vitest run --config vite.renderer.config.ts \
			src/main/app-state.test.ts \
			src/main/daemon-owner.test.ts \
			src/shared/daemon-launch.test.ts \
			src/renderer/i18n/renderer-coverage.test.ts \
			src/renderer/lib/api-client.test.ts \
			src/renderer/lib/command-palette.test.ts \
			src/renderer/lib/spawn-orchestrator.test.ts \
			src/renderer/__tests__/integration/board-empty-states.test.tsx \
			src/renderer/components/CommandPalette.test.tsx \
			src/renderer/components/ProjectSettingsForm.test.tsx \
			src/renderer/components/RestoreUnavailableDialog.test.tsx \
			src/renderer/components/SessionInspector.test.tsx \
			src/renderer/components/SessionsBoard.test.tsx \
			src/renderer/components/ShellTopbar.test.tsx \
			src/renderer/components/Sidebar.test.tsx
		AO_TELEMETRY_RENDERER=off AO_TELEMETRY_EVENTS=off AO_TELEMETRY_METRICS=off AO_TELEMETRY_REMOTE=off \
			VITE_AO_POSTHOG_KEY= npm run package -- --arch=arm64
	)
	output="$(dcp_ao_package_output "$lab_root")"
	codesign --force --deep --sign - "$output"
	dcp_ao_verify_bundle_at "$output"
	dcp_ao_verify_source "$lab_root"
	printf '%s\n' "$output"
}

install_built_app_locked() {
	local lab_root="$1" install_mode="${2:-stage5}" built app parent staging backup_root backup_app backup_stamp receipt receipt_staging app_pid failed_app runtime_cli activation_output receipt_sha failed_data failure_label output_label
	case "$install_mode" in
		stage5) failure_label='stopped DCP v2 Stage 5 activation'; output_label=activation ;;
		stage6-recovery) failure_label='stopped DCP v2 Stage 6 recovery'; output_label=recovery ;;
		stage6-aggregate) failure_label='stopped DCP v2 Stage 6 aggregate install'; output_label=aggregate ;;
		*) dcp_ao_fail "unknown install mode: $install_mode"; return 1 ;;
	esac
	built="$(dcp_ao_package_output "$lab_root")"; app="$(dcp_ao_app_path)"; parent="$(dirname "$app")"
	runtime_cli="$(dcp_ao_embedded_cli)"
	if [[ -e "$app" ]]; then
		dcp_ao_verify_replaceable_bundle_at "$app" || { dcp_ao_fail 'refusing to replace an app with foreign identity'; return 1; }
		dcp_ao_verify_replaceable_install_receipt "$lab_root" || { dcp_ao_fail 'refusing to replace an app with an unverified receipt'; return 1; }
	else
		runtime_cli="$built/Contents/Resources/daemon/dcp-orchestratord"
	fi
	dcp_ao_install_prepare_runtime "$lab_root" "$runtime_cli" || return 1
	if [[ "$install_mode" == stage6-aggregate ]]; then
		dcp_ao_verify_twin_stage6_aggregate_fence "$lab_root" 1 || return 1
	fi
	mkdir -p "$parent" "$lab_root/build/backups" "$(dirname "$(dcp_ao_install_receipt "$lab_root")")"
	staging="$parent/.DCP-Orchestrator-install-$$.app"
	[[ ! -e "$staging" ]] || { dcp_ao_fail 'install staging path already exists'; return 1; }
	ditto "$built" "$staging"
	codesign --force --deep --sign - "$staging"
	dcp_ao_verify_bundle_at "$staging"
	backup_root=''
	if [[ -e "$app" ]]; then
		backup_stamp="$(date -u +%Y%m%dT%H%M%SZ)"
		backup_root="$lab_root/build/backups/i12-$backup_stamp"
		backup_app="$backup_root/DCP Orchestrator.app"
		[[ ! -e "$backup_root" ]] || { dcp_ao_fail 'install backup path already exists'; return 1; }
		mkdir -p "$backup_root"
		[[ ! -d "$lab_root/state" ]] || ditto "$lab_root/state" "$backup_root/state"
		[[ ! -d "$lab_root/data" ]] || ditto "$lab_root/data" "$backup_root/data"
		[[ ! -d "$lab_root/state" ]] || diff -qr "$lab_root/state" "$backup_root/state" >/dev/null
		[[ ! -d "$lab_root/data" ]] || diff -qr "$lab_root/data" "$backup_root/data" >/dev/null
		{
			printf 'schema=1\n'
			printf 'created_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
			printf 'prior_bundle_path=%s\n' "$app"
			printf 'backup_bundle_path=%s\n' "$backup_app"
			printf 'upstream_commit=%s\n' "$DCP_AO_UPSTREAM_COMMIT"
			printf 'prior_daemon_sha256=%s\n' "$(dcp_ao_sha256 "$app/Contents/Resources/daemon/dcp-orchestratord")"
			printf 'prior_asar_sha256=%s\n' "$(dcp_ao_sha256 "$app/Contents/Resources/app.asar")"
			printf 'prior_receipt_sha256=%s\n' "$(dcp_ao_sha256 "$(dcp_ao_install_receipt "$lab_root")")"
			printf 'state_backup=%s\n' "$backup_root/state"
			printf 'data_backup=%s\n' "$backup_root/data"
		} >"$backup_root/manifest"
		chmod 600 "$backup_root/manifest"
		mv "$app" "$backup_app"
	fi
	if ! mv "$staging" "$app" || ! dcp_ao_verify_bundle_at "$app"; then
		if [[ -n "$backup_root" && -d "$backup_app" ]]; then
			failed_app="$backup_root/failed-new-bundle.app"
			[[ ! -e "$app" ]] || mv "$app" "$failed_app"
			mv "$backup_app" "$app"
			dcp_ao_verify_replaceable_bundle_at "$app" || dcp_ao_fail 'automatic bundle rollback verification failed'
		fi
		dcp_ao_fail 'new bundle installation failed; prior bundle rollback was attempted'
		return 1
	fi
	receipt="$(dcp_ao_install_receipt "$lab_root")"; receipt_staging="$receipt.i12-$$"
	if ! {
		{
			printf 'schema=1\n'
			printf 'bundle_path=%s\n' "$app"
			printf 'bundle_id=pro.devcontrol.dcp-orchestrator\n'
			printf 'fork_commit=%s\n' "$DCP_AO_FORK_COMMIT"
			printf 'fork_tree=%s\n' "$DCP_AO_FORK_TREE"
			printf 'upstream_commit=%s\n' "$DCP_AO_UPSTREAM_COMMIT"
			printf 'i8_parity_diff_sha256=%s\n' "$DCP_AO_I8_PARITY_DIFF_SHA256"
			printf 'daemon_sha256=%s\n' "$(dcp_ao_sha256 "$(dcp_ao_embedded_cli)")"
			printf 'asar_sha256=%s\n' "$(dcp_ao_sha256 "$app/Contents/Resources/app.asar")"
			printf 'installed_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		} >"$receipt_staging" &&
		chmod 600 "$receipt_staging" &&
		mv "$receipt_staging" "$receipt" &&
		dcp_ao_verify_installed_bundle "$lab_root"
	}; then
		if [[ -n "$backup_root" && -d "$backup_app" ]]; then
			failed_app="$backup_root/failed-new-bundle.app"
			mv "$app" "$failed_app"
			mv "$backup_app" "$app"
			if [[ -f "$backup_root/state/install.receipt" ]]; then ditto "$backup_root/state/install.receipt" "$receipt"; fi
			dcp_ao_verify_replaceable_bundle_at "$app" || dcp_ao_fail 'receipt-failure bundle rollback verification failed'
			dcp_ao_verify_replaceable_install_receipt "$lab_root" || dcp_ao_fail 'receipt-failure prior receipt rollback verification failed'
		fi
		dcp_ao_fail 'installed fork receipt verification failed; prior bundle rollback was attempted'
		return 1
	fi
	receipt_sha="$(dcp_ao_sha256 "$receipt")"
	dcp_ao_export_runtime_env "$lab_root"
	if [[ "$install_mode" == stage5 ]]; then
		if ! activation_output="$("$(dcp_ao_embedded_cli)" dcp stage5-activate \
			--source-commit "$DCP_AO_FORK_COMMIT" \
			--source-tree "$DCP_AO_FORK_TREE" \
			--install-receipt-sha "$receipt_sha" \
			--target-path "$lab_root/targets/dcp-wbc-integration-lab" --json)" || \
			! dcp_ao_validate_twin_stage5_activation_response "$lab_root" "$receipt_sha" "$activation_output"; then
			activation_output=''
		fi
	elif [[ "$install_mode" == stage6-recovery ]]; then
		if ! activation_output="$("$(dcp_ao_embedded_cli)" dcp stage6-recovery-preflight \
			--source-commit "$DCP_AO_FORK_COMMIT" \
			--source-tree "$DCP_AO_FORK_TREE" \
			--install-receipt-sha "$receipt_sha" --json)" || \
			! dcp_ao_validate_twin_stage6_recovery_response "$receipt_sha" "$activation_output" || \
			! dcp_ao_verify_installed_bundle "$lab_root" || \
			! dcp_ao_verify_twin_stage6_recovery_fence "$lab_root" 85 1; then
			activation_output=''
		fi
	else
		if ! activation_output="$(dcp_ao_twin_stage6_aggregate_response "$receipt_sha")" || \
			! dcp_ao_validate_twin_stage6_aggregate_response "$receipt_sha" "$activation_output" || \
			! dcp_ao_verify_installed_bundle "$lab_root" || \
			! dcp_ao_verify_twin_stage6_aggregate_fence "$lab_root" 1 || \
			! dcp_ao_verify_twin_stage6_external_fence; then
			activation_output=''
		fi
	fi
	if [[ -z "$activation_output" ]]; then
		if [[ -n "$backup_root" && -d "$backup_app" && -d "$backup_root/data" ]]; then
			failed_app="$backup_root/failed-new-bundle.app"
			[[ ! -e "$app" ]] || mv "$app" "$failed_app"
			mv "$backup_app" "$app"
			failed_data="$backup_root/failed-new-data"
			[[ ! -e "$failed_data" ]] || { dcp_ao_fail 'activation rollback data target already exists'; return 1; }
			mv "$lab_root/data" "$failed_data"
			ditto "$backup_root/data" "$lab_root/data"
			if [[ -f "$backup_root/state/install.receipt" ]]; then ditto "$backup_root/state/install.receipt" "$receipt"; fi
			dcp_ao_verify_replaceable_bundle_at "$app" || dcp_ao_fail 'activation-failure bundle rollback verification failed'
			dcp_ao_verify_replaceable_install_receipt "$lab_root" || dcp_ao_fail 'activation-failure prior receipt rollback verification failed'
			if [[ "$install_mode" == stage6-recovery ]]; then
				dcp_ao_verify_twin_stage6_recovery_fence "$lab_root" 84 1 || dcp_ao_fail 'Stage 6 recovery rollback identity verification failed'
			elif [[ "$install_mode" == stage6-aggregate ]]; then
				verify_stage6_aggregate_predecessor_receipt "$lab_root" || dcp_ao_fail 'Stage 6 aggregate rollback receipt verification failed'
				dcp_ao_verify_twin_stage6_aggregate_fence "$lab_root" 1 || dcp_ao_fail 'Stage 6 aggregate rollback identity verification failed'
			fi
		fi
		dcp_ao_fail "$failure_label failed; prior bundle/data rollback was attempted"
		return 1
	fi
	if [[ -n "$backup_root" ]]; then printf 'backup %s\n' "$backup_root"; fi
	printf '%s %s\n' "$output_label" "$activation_output"
	printf 'installed %s\n' "$app"
}

install_app() {
	local lab_root="$1" result
	[[ "$DCP_AO_FORK_COMMIT" == "$DCP_AO_TWIN_STAGE5_SOURCE_COMMIT" && "$DCP_AO_FORK_TREE" == "$DCP_AO_TWIN_STAGE5_SOURCE_TREE" ]] || {
		dcp_ao_fail 'generic Stage 5 install is disabled for Stage 6 locks; use the exact reviewed Stage 6 install command'; return 1;
	}
	[[ "$(dcp_ao_validate_twin_target "$lab_root" 0 1)" == "$lab_root/targets/dcp-wbc-integration-lab" ]] || return 1
	build_app "$lab_root"
	dcp_ao_gateway_acquire_lock "$lab_root" || return 1
	if install_built_app_locked "$lab_root"; then result=0; else result=$?; fi
	dcp_ao_gateway_release_lock "$lab_root"
	return "$result"
}

verify_stage6_recovery_preinstall() {
	local lab_root="$1" receipt
	[[ "$(dcp_ao_validate_twin_target "$lab_root" 0 1)" == "$lab_root/targets/dcp-wbc-integration-lab" ]] || return 1
	dcp_ao_verify_replaceable_bundle_at "$(dcp_ao_app_path)" || return 1
	dcp_ao_verify_replaceable_install_receipt "$lab_root" || return 1
	receipt="$(dcp_ao_install_receipt "$lab_root")"
	[[ "$(dcp_ao_sha256 "$receipt")" == "$DCP_AO_TWIN_STAGE5_RECEIPT_SHA256" ]] || {
		dcp_ao_fail 'Stage 6 recovery preinstall receipt is not the immutable Stage 5 receipt'; return 1;
	}
	grep -Fxq "fork_commit=$DCP_AO_TWIN_STAGE5_SOURCE_COMMIT" "$receipt" || return 1
	grep -Fxq "fork_tree=$DCP_AO_TWIN_STAGE5_SOURCE_TREE" "$receipt" || return 1
	dcp_ao_verify_twin_stage6_recovery_fence "$lab_root" 84 1
}

install_stage6_recovery_app() {
	local lab_root="$1" result
	[[ "$DCP_AO_FORK_COMMIT" == "$DCP_AO_TWIN_STAGE6_RECOVERY_SOURCE_COMMIT" && \
		"$DCP_AO_FORK_TREE" == "$DCP_AO_TWIN_STAGE6_RECOVERY_SOURCE_TREE" ]] || {
		dcp_ao_fail 'historical Stage 6 recovery install is disabled for the aggregate lock; use install-stage6-aggregate'; return 1;
	}
	verify_stage6_recovery_preinstall "$lab_root" || return 1
	build_app "$lab_root"
	dcp_ao_gateway_acquire_lock "$lab_root" || return 1
	if verify_stage6_recovery_preinstall "$lab_root" && install_built_app_locked "$lab_root" stage6-recovery; then result=0; else result=$?; fi
	dcp_ao_gateway_release_lock "$lab_root"
	return "$result"
}

verify_stage6_aggregate_predecessor_receipt() {
	local lab_root="$1" receipt
	dcp_ao_verify_replaceable_bundle_at "$(dcp_ao_app_path)" || return 1
	dcp_ao_verify_replaceable_install_receipt "$lab_root" || return 1
	receipt="$(dcp_ao_install_receipt "$lab_root")"
	[[ "$(dcp_ao_sha256 "$receipt")" == "$DCP_AO_TWIN_STAGE6_RECOVERY_RECEIPT_SHA256" ]] || {
		dcp_ao_fail 'Stage 6 aggregate predecessor receipt digest differs'; return 1;
	}
	grep -Fxq "fork_commit=$DCP_AO_TWIN_STAGE6_RECOVERY_SOURCE_COMMIT" "$receipt" || return 1
	grep -Fxq "fork_tree=$DCP_AO_TWIN_STAGE6_RECOVERY_SOURCE_TREE" "$receipt" || return 1
}

verify_stage6_aggregate_preinstall() {
	local lab_root="$1"
	[[ "$(dcp_ao_validate_twin_target "$lab_root" 0 1)" == "$lab_root/targets/dcp-wbc-integration-lab" ]] || return 1
	verify_stage6_aggregate_predecessor_receipt "$lab_root" || return 1
	dcp_ao_verify_twin_stage6_aggregate_fence "$lab_root" 0 || return 1
	dcp_ao_verify_twin_stage6_external_fence
}

install_stage6_aggregate_app() {
	local lab_root="$1" result
	[[ "$DCP_AO_FORK_COMMIT" == "$DCP_AO_TWIN_STAGE6_AGGREGATE_SOURCE_COMMIT" && \
		"$DCP_AO_FORK_TREE" == "$DCP_AO_TWIN_STAGE6_AGGREGATE_SOURCE_TREE" ]] || {
		dcp_ao_fail 'historical Stage 6 aggregate install is disabled for the direct-model lock'; return 1;
	}
	verify_stage6_aggregate_preinstall "$lab_root" || return 1
	build_app "$lab_root"
	dcp_ao_gateway_acquire_lock "$lab_root" || return 1
	if verify_stage6_aggregate_preinstall "$lab_root" && install_built_app_locked "$lab_root" stage6-aggregate; then result=0; else result=$?; fi
	dcp_ao_gateway_release_lock "$lab_root"
	return "$result"
}

preflight_stage6_aggregate() {
	local lab_root="$1" receipt receipt_sha response
	dcp_ao_preflight_exact_contour "$lab_root"
	dcp_ao_verify_twin_stage6_aggregate_fence "$lab_root" 1
	dcp_ao_verify_twin_stage6_external_fence
	receipt="$(dcp_ao_install_receipt "$lab_root")"; receipt_sha="$(dcp_ao_sha256 "$receipt")"
	response="$(dcp_ao_twin_stage6_aggregate_response "$receipt_sha")"
	dcp_ao_validate_twin_stage6_aggregate_response "$receipt_sha" "$response"
	printf 'aggregate %s\n' "$response"
	dcp_ao_print_contour "$lab_root"
}

command="${1:-}"; [[ -n "$command" ]] || { usage; exit 2; }; shift || true
[[ "$#" -eq 0 ]] || dcp_ao_fail "unexpected arguments for $command"
if [[ "$command" == -h || "$command" == --help || "$command" == help ]]; then usage; exit 0; fi
lab_root="$(dcp_ao_require_lab_root)"

case "$command" in
	prepare) dcp_ao_prepare_source "$lab_root" >/dev/null; dcp_ao_verify_source "$lab_root"; printf 'prepared %s\n' "$(dcp_ao_source_dir "$lab_root")" ;;
	deps) source_dir="$(dcp_ao_prepare_source "$lab_root")"; install_deps "$source_dir"; dcp_ao_verify_source "$lab_root" ;;
	build) build_app "$lab_root" ;;
	install) install_app "$lab_root" ;;
	install-stage6-recovery) install_stage6_recovery_app "$lab_root" ;;
	install-stage6-aggregate) install_stage6_aggregate_app "$lab_root" ;;
	install-stage6-direct-model) install_stage6_direct_model_app "$lab_root" ;;
	install-stage6-final) install_stage6_final_app "$lab_root" ;;
	preflight) dcp_ao_preflight_exact_contour "$lab_root"; dcp_ao_print_contour "$lab_root" ;;
	preflight-stage5) dcp_ao_preflight_exact_contour "$lab_root"; dcp_ao_verify_twin_stopped_activation "$lab_root" 1 1; dcp_ao_print_contour "$lab_root" ;;
	preflight-stage6-recovery) dcp_ao_preflight_exact_contour "$lab_root"; dcp_ao_verify_twin_stage6_recovery_fence "$lab_root" 85 1; dcp_ao_print_contour "$lab_root" ;;
	preflight-stage6-aggregate) preflight_stage6_aggregate "$lab_root" ;;
	preflight-stage6-direct-model) preflight_stage6_direct_model "$lab_root" ;;
	preflight-stage6-final) preflight_stage6_final "$lab_root" ;;
	adopt-stage6-final) adopt_stage6_final "$lab_root" ;;
	preflight-stage6-final-adopted) preflight_stage6_final_adopted "$lab_root" ;;
	continue-stage6-final) continue_stage6_final "$lab_root" ;;
	restart-stage6-final-dedupe) restart_stage6_final_dedupe "$lab_root" ;;
	init-target) init_target "$lab_root" ;;
	init-wb-core) dcp_ao_init_wb_core_target "$lab_root" ;;
	init-twin) dcp_ao_init_twin_target "$lab_root" ;;
	register-wb-core) dcp_ao_register_wb_core "$lab_root" ;;
	status|doctor)
		dcp_ao_verify_installed_bundle "$lab_root"; dcp_ao_export_runtime_env "$lab_root"; cli="$(dcp_ao_embedded_cli)"
		if [[ "$command" == status ]]; then "$cli" status --json; else "$cli" doctor --json; fi
		;;
	paths) dcp_ao_print_contour "$lab_root" ;;
	*) usage >&2; exit 2 ;;
esac
