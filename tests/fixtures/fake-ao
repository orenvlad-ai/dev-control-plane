#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"${DCP_AO_FAKE_LOG:?}"
case "${1:-} ${2:-}" in
	'status --json') printf '{\n  "state": "ready"\n}\n' ;;
	'project ls') printf '{\n  "projects": []\n}\n' ;;
	'project add') printf 'registered project\n' ;;
	'project set-config') printf 'updated project config\n' ;;
	'project get')
		if [[ "${3:-}" == dcp-review-lab ]]; then
			fake_lab_root="$(cd "${DCP_AO_LAB_ROOT:?}" && pwd -P)"
			printf '{"status":"ok","project":{"id":"dcp-review-lab","kind":"single_repo","path":"%s/targets/dcp-review-lab","repo":"https://github.com/orenvlad-ai/dcp-review-lab.git","defaultBranch":"main","config":%s}}\n' "$fake_lab_root" "$(printf '%s' '{"defaultBranch":"main","sessionPrefix":"dcp-review-lab","worker":{"agent":"codex","agentConfig":{"permissions":"accept-edits","dcpReviewLabNetwork":true}},"reviewers":[{"harness":"codex"}],"agentRules":"DCP synthetic PR profile v4. Work only in this exact public synthetic repository, current native worktree and current AO branch. Do not create subagents, extra branches, worktrees, remotes, network services or additional pull requests. On the initial policy action implement only the direct task, create one commit lineage, push the current branch, open one ready pull request targeting main, and stop. If the trusted daemon supplies the one bounded findings-repair envelope, change only that task on the same branch and pull request, create one new head, push, and stop. Never merge or manually review; only the trusted daemon may perform exact-head review, FIFO admission and terminal merge."}')"
		else
			printf '{"status":"ok","project":{"id":"dcp-lab","path":"%s/targets/dcp-lab"}}\n' "${DCP_AO_LAB_ROOT:?}"
		fi
		;;
	'dcp submit')
		[[ "${DCP_AO_FAKE_POLICY_CONFLICT:-0}" != 1 ]] || { printf 'conflicting replay\n' >&2; exit 1; }
		fake_task_id='' fake_prompt=''
		shift 2
		while [[ "$#" -gt 0 ]]; do
			case "$1" in
				--task-id) fake_task_id="$2"; shift 2 ;;
				--prompt) fake_prompt="$2"; shift 2 ;;
				--target|--profile|--repository) shift 2 ;;
				--json) shift ;;
				*) exit 1 ;;
			esac
		done
		fake_card="${DCP_AO_FAKE_POLICY_CARD:-13}"
		fake_session="dcp-review-lab-$fake_card"
		/usr/bin/jq -n \
			--arg task "$fake_task_id" --arg prompt "$fake_prompt" \
			--arg session "$fake_session" --arg card "$fake_card" \
			--arg root "$(cd "${DCP_AO_LAB_ROOT:?}" && pwd -P)" \
			--arg sessionOverride "${DCP_AO_FAKE_POLICY_SESSION:-$fake_session}" \
			--arg state "${DCP_AO_FAKE_POLICY_STATE:-worker_running}" \
			--argjson duplicate "${DCP_AO_FAKE_POLICY_DUPLICATE:-false}" \
			'{task:{taskId:$task,sessionId:$sessionOverride,cardNumber:($card|tonumber),worktreePath:($root+"/data/worktrees/dcp-review-lab/"+$session),sourceBranch:("ao/"+$session+"/root"),state:$state,revision:3},duplicate:$duplicate}'
		;;
	'session ls')
		case "${DCP_AO_FAKE_SESSION_STATE:-empty}" in
			prestage) printf '{"data":[{"id":"dcp-review-lab-8"}],"meta":{}}\n' ;;
			empty) printf '{"data":[{"id":"dcp-review-lab-8"},{"id":"dcp-review-lab-9"},{"id":"dcp-review-lab-10"}],"meta":{}}\n' ;;
			one) printf '{"data":[{"id":"dcp-review-lab-8"},{"id":"dcp-review-lab-9"},{"id":"dcp-review-lab-10"},{"id":"dcp-review-lab-11"}],"meta":{}}\n' ;;
			full) printf '{"data":[{"id":"dcp-review-lab-8"},{"id":"dcp-review-lab-9"},{"id":"dcp-review-lab-10"},{"id":"dcp-review-lab-11"},{"id":"dcp-review-lab-12"}],"meta":{}}\n' ;;
			gap) printf '{"data":[{"id":"dcp-review-lab-8"},{"id":"dcp-review-lab-9"},{"id":"dcp-review-lab-10"},{"id":"dcp-review-lab-12"}],"meta":{}}\n' ;;
			future) printf '{"data":[{"id":"dcp-review-lab-8"},{"id":"dcp-review-lab-9"},{"id":"dcp-review-lab-10"},{"id":"dcp-review-lab-13"}],"meta":{}}\n' ;;
			*) exit 1 ;;
		esac
		;;
	'session get')
		fake_task_id=existing-task
		case "${3:-}" in
			dcp-review-lab-9) fake_task_id="${DCP_AO_FAKE_STAGE1_CARD9_TASK_ID:-i13-admit-a}" ;;
			dcp-review-lab-10) fake_task_id=i13-admit-b ;;
			dcp-review-lab-11) fake_task_id="${DCP_AO_FAKE_TASK_ID:-existing-task}" ;;
			dcp-review-lab-12) fake_task_id=i13-arbiter-b ;;
		esac
		printf '{"session":{"id":"%s","projectId":"dcp-review-lab","displayName":"DCP:%s"}}\n' "${3:-}" "$fake_task_id"
		;;
	'spawn --project')
		if [[ "${3:-}" == dcp-review-lab ]]; then
			if [[ "${DCP_AO_FAKE_SESSION_STATE:-empty}" == one ]]; then
				printf 'spawned session dcp-review-lab-12 (active) [prompt 42 B, system 100 B]\n'
			else
				printf 'spawned session dcp-review-lab-11 (active) [prompt 42 B, system 100 B]\n'
			fi
		else
			printf 'spawned session dcp-i3-0001 (active) [prompt 42 B, system 100 B]\n'
		fi
		;;
	*) printf 'unexpected fake AO call: %s\n' "$*" >&2; exit 1 ;;
esac
