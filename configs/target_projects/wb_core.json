{
  "codex_prompt_contract": {
    "final_blocks": [
      "=== ДЛЯ КУРАТОРА ===",
      "=== СЖАТАЯ ПРОВЕРКА ==="
    ],
    "required_headers": [
      "Класс задачи:",
      "Причина классификации:",
      "Режим выполнения:"
    ]
  },
  "control_plane_notes": [
    "ordinary ChatGPT Project tasks must use direct start_wb_core_auto_task production-capable intake",
    "start_sprint, curator ping-pong, parent/child decomposition and DEVCONTROL_START_SPRINT_V1 bridge are frozen for operator flow",
