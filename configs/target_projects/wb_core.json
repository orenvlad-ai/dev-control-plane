      "/opt/wb-core-runtime/state/promo_campaign_archive",
      "/opt/wb-core-runtime/state/promo_xlsx_collector_runs",
      "/opt/wb-core-runtime/state/registry_upload_runtime.sqlite3"
    ],
    "browser_session_paths": [
