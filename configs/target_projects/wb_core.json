    "service_user": "dev-control-plane",
    "service_group": "dev-control-plane",
    "forbidden_secret_surfaces": [
      ".env",
      "auth.json",
      "cookies",
      "tokens",
      "browser raw profile storage"
    ]
  },
  "default_forbidden_actions": [
    "live_deploy",
    "ssh",
    "root_shell",
    "public_route_change",
    "selleros_product_plane_route",
    "google_sheets_gas_write",
