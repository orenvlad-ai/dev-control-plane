# Example only. Keep the application on 127.0.0.1:8770. The permanent HTTP
# ACME route must survive certificate issuance and every renewal.

server {
    listen 80;
    server_name devcontrol.pro www.devcontrol.pro;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/dev-control-plane-acme;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name devcontrol.pro www.devcontrol.pro;

    ssl_certificate /etc/letsencrypt/live/devcontrol.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devcontrol.pro/privkey.pem;

    auth_basic "Development Control Plane";
    auth_basic_user_file /etc/nginx/dev-control-plane.htpasswd;

    # This is the only Basic Auth exception. The application still requires
    # the exact HMAC v2 envelope and returns ACK data only.
    location = /api/v2/ingest {
        auth_basic off;
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:8770;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8770;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
