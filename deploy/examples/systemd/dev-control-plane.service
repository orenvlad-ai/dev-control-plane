[Unit]
Description=Development Control Plane cockpit
Documentation=https://github.com/orenvlad-ai/dev-control-plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dev-control-plane
Group=dev-control-plane
WorkingDirectory=/opt/dev-control-plane-runtime/app
EnvironmentFile=/opt/dev-control-plane-runtime/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/dev-control-plane-runtime/app/apps/dev_control_plane_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dev-control-plane-runtime

[Install]
WantedBy=multi-user.target
